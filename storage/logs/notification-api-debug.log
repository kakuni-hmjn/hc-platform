     1	<?php
     2	
     3	declare(strict_types=1);
     4	
     5	header('Content-Type: application/json; charset=UTF-8');
     6	header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
     7	
     8	require_once dirname(__DIR__, 2) . '/lib/bootstrap.php';
     9	
    10	/**
    11	 * JSONレスポンスを返して終了する。
    12	 *
    13	 * @param array<string, mixed> $payload
    14	 */
    15	function notification_json(array $payload, int $status = 200): never
    16	{
    17	    http_response_code($status);
    18	
    19	    echo json_encode(
    20	        $payload,
    21	        JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
    22	    );
    23	
    24	    exit;
    25	}
    26	
    27	/**
    28	 * bootstrap.phpからPDO接続を取得する。
    29	 */
    30	function notification_resolve_pdo(): ?PDO
    31	{
    32	    global $pdo, $db;
    33	
    34	    if (isset($pdo) && $pdo instanceof PDO) {
    35	        return $pdo;
    36	    }
    37	
    38	    if (isset($db) && $db instanceof PDO) {
    39	        return $db;
    40	    }
    41	
    42	    foreach ([
    43	        'db',
    44	        'database',
    45	        'get_db',
    46	        'get_database',
    47	        'staff_db',
    48	        'app_db',
    49	    ] as $functionName) {
    50	        if (!function_exists($functionName)) {
    51	            continue;
    52	        }
    53	
    54	        try {
    55	            $connection = $functionName();
    56	
    57	            if ($connection instanceof PDO) {
    58	                return $connection;
    59	            }
    60	        } catch (Throwable) {
    61	            // 次の候補を確認する
    62	        }
    63	    }
    64	
    65	    return null;
    66	}
    67	
    68	/**
    69	 * ログイン中スタッフのIDを取得する。
    70	 */
    71	function notification_resolve_staff_user_id(): ?int
    72	{
    73	    global $currentStaffUser, $staffUser, $currentUser;
    74	
    75	    $candidates = [
    76	        $currentStaffUser ?? null,
    77	        $staffUser ?? null,
    78	        $currentUser ?? null,
    79	        $_SESSION['staff_user'] ?? null,
    80	        $_SESSION['current_staff_user'] ?? null,
    81	        $_SESSION['user'] ?? null,
    82	    ];
    83	
    84	    foreach ($candidates as $candidate) {
    85	        if (!is_array($candidate)) {
    86	            continue;
    87	        }
    88	
    89	        foreach (['id', 'staff_user_id', 'user_id'] as $key) {
    90	            if (
    91	                isset($candidate[$key])
    92	                && filter_var($candidate[$key], FILTER_VALIDATE_INT) !== false
    93	            ) {
    94	                $id = (int) $candidate[$key];
    95	
    96	                if ($id > 0) {
    97	                    return $id;
    98	                }
    99	            }
   100	        }
   101	    }
   102	
   103	    foreach ([
   104	        $_SESSION['staff_user_id'] ?? null,
   105	        $_SESSION['staff_id'] ?? null,
   106	        $_SESSION['user_id'] ?? null,
   107	    ] as $candidateId) {
   108	        if (filter_var($candidateId, FILTER_VALIDATE_INT) !== false) {
   109	            $id = (int) $candidateId;
   110	
   111	            if ($id > 0) {
   112	                return $id;
   113	            }
   114	        }
   115	    }
   116	
   117	    foreach ([
   118	        'current_staff_user_id',
   119	        'staff_user_id',
   120	        'authenticated_staff_user_id',
   121	    ] as $functionName) {
   122	        if (!function_exists($functionName)) {
   123	            continue;
   124	        }
   125	
   126	        try {
   127	            $id = (int) $functionName();
   128	
   129	            if ($id > 0) {
   130	                return $id;
   131	            }
   132	        } catch (Throwable) {
   133	            // 次の候補を確認する
   134	        }
   135	    }
   136	
   137	    return null;
   138	}
   139	
   140	if ($_SERVER['REQUEST_METHOD'] !== 'GET') {
   141	    header('Allow: GET');
   142	
   143	    notification_json([
   144	        'ok' => false,
   145	        'error' => 'method_not_allowed',
   146	        'message' => 'GETメソッドのみ利用できます。',
   147	    ], 405);
   148	}
   149	
   150	$pdo = notification_resolve_pdo();
   151	
   152	if (!$pdo instanceof PDO) {
   153	    notification_json([
   154	        'ok' => false,
   155	        'error' => 'database_connection_not_found',
   156	        'message' => 'データベース接続を取得できませんでした。',
   157	    ], 500);
   158	}
   159	
   160	$staffUserId = notification_resolve_staff_user_id();
   161	
   162	if ($staffUserId === null) {
   163	    notification_json([
   164	        'ok' => false,
   165	        'error' => 'unauthorized',
   166	        'message' => 'ログイン中のスタッフを確認できませんでした。',
   167	    ], 401);
   168	}
   169	
   170	$allowedCategories = [
   171	    'all',
   172	    'system',
   173	    'order',
   174	    'user',
   175	    'discord',
   176	    'github',
   177	    'development',
   178	];
   179	
   180	$category = strtolower(trim((string) ($_GET['category'] ?? 'all')));
   181	
   182	if (!in_array($category, $allowedCategories, true)) {
   183	    notification_json([
   184	        'ok' => false,
   185	        'error' => 'invalid_category',
   186	        'message' => '指定された通知カテゴリは利用できません。',
   187	    ], 422);
   188	}
   189	
   190	$limit = filter_input(
   191	    INPUT_GET,
   192	    'limit',
   193	    FILTER_VALIDATE_INT,
   194	    [
   195	        'options' => [
   196	            'default' => 20,
   197	            'min_range' => 1,
   198	            'max_range' => 50,
   199	        ],
   200	    ]
   201	);
   202	
   203	if (!is_int($limit)) {
   204	    $limit = 20;
   205	}
   206	
   207	try {
   208	    $unreadStatement = $pdo->prepare(
   209	        <<<'SQL'
   210	        SELECT COUNT(*)
   211	        FROM staff_notifications
   212	        WHERE user_id = :user_id
   213	          AND is_read = FALSE
   214	        SQL
   215	    );
   216	
   217	    $unreadStatement->execute([
   218	        ':user_id' => $staffUserId,
   219	    ]);
   220	
   221	    $unreadCount = (int) $unreadStatement->fetchColumn();
   222	
   223	    $whereCategory = '';
   224	    $parameters = [
   225	        ':user_id' => $staffUserId,
   226	    ];
   227	
   228	    if ($category !== 'all') {
   229	        $whereCategory = ' AND category = :category';
   230	        $parameters[':category'] = $category;
   231	    }
   232	
   233	    $query = <<<SQL
   234	        SELECT
   235	            id,
   236	            type,
   237	            category,
   238	            level,
   239	            title,
   240	            body,
   241	            action_url,
   242	            icon,
   243	            source,
   244	            metadata,
   245	            is_read,
   246	            read_at,
   247	            created_at,
   248	            updated_at
   249	        FROM staff_notifications
   250	        WHERE user_id = :user_id
   251	        {$whereCategory}
   252	        ORDER BY created_at DESC, id DESC
   253	        LIMIT {$limit}
   254	        SQL;
   255	
   256	    $statement = $pdo->prepare($query);
   257	    $statement->execute($parameters);
   258	
   259	    $items = [];
   260	
   261	    while ($row = $statement->fetch(PDO::FETCH_ASSOC)) {
   262	        $metadata = $row['metadata'] ?? [];
   263	
   264	        if (is_string($metadata)) {
   265	            $decodedMetadata = json_decode($metadata, true);
   266	            $metadata = is_array($decodedMetadata) ? $decodedMetadata : [];
   267	        }
   268	
   269	        $items[] = [
   270	            'id' => (int) $row['id'],
   271	            'type' => (string) $row['type'],
   272	            'category' => (string) ($row['category'] ?? 'system'),
   273	            'level' => (string) ($row['level'] ?? 'info'),
   274	            'title' => (string) $row['title'],
   275	            'message' => (string) ($row['body'] ?? ''),
   276	            'url' => $row['action_url'] !== null
   277	                ? (string) $row['action_url']
   278	                : null,
   279	            'icon' => $row['icon'] !== null
   280	                ? (string) $row['icon']
   281	                : null,
   282	            'source' => (string) ($row['source'] ?? 'hc-platform'),
   283	            'metadata' => $metadata,
   284	            'is_read' => (bool) $row['is_read'],
   285	            'read_at' => $row['read_at'],
   286	            'created_at' => $row['created_at'],
   287	        ];
   288	    }
   289	
   290	    notification_json([
   291	        'ok' => true,
   292	        'unread' => $unreadCount,
   293	        'category' => $category,
   294	        'items' => $items,
   295	    ]);
   296	} catch (Throwable $exception) {
   297	    error_log(
   298	        '[staff notifications API] '
   299	        . $exception->getMessage()
   300	    );
   301	
   302	    notification_json([
   303	        'ok' => false,
   304	        'error' => 'notification_fetch_failed',
   305	        'message' => '通知の取得に失敗しました。',
   306	    ], 500);
   307	}

